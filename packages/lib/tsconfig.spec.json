{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./dist/tsconfig.spec.tsbuildinfo",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "types/**/*.d.ts",
    "__tests__/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
